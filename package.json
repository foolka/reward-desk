{
  "name": "reward-desk",
  "productName": "Reward Desk",
  "version": "0.9.0",
  "private": true,
  "description": "Direct Twitch sound and video rewards for OBS",
  "author": "FermionaPlay",
  "license": "GPL-2.0-or-later",
  "main": "main.cjs",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/test-ui.cjs",
    "test:library-ui": "node tools/test-library-ui.cjs",
    "test:channel-ui": "node tools/test-channel-ui.cjs",
    "test:chat-ui": "node tools/test-chat-ui.cjs",
    "test:video-layout": "node tools/test-video-layout.cjs",
    "test:video-controls": "node tools/test-video-controls.cjs",
    "test:recovery-ui": "node tools/test-recovery-ui.cjs",
    "test:appearance-ui": "node tools/test-appearance-ui.cjs",
    "test:update-helper": "node tools/test-update-helper.cjs",
    "build": "node tools/build.cjs",
    "installer": "node tools/build-installer.cjs",
    "build:obs": "node tools/build-obs.cjs",
    "package:obs": "node tools/build.cjs --obs-plugin",
    "installer:obs": "node tools/build-obs-installer.cjs",
    "test:obs": "node tools/test-obs-editor.cjs"
  },
  "dependencies": {
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/eventsub-ws": "8.2.0",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "electron": "42.11.8",
    "@electron/packager": "20.3.0",
    "playwright": "1.58.2"
  }
}
